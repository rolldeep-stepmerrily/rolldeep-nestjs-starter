{
  "name": "fixme",
  "version": "2.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "start:dev": "prisma generate && nest start --watch",
    "start:prod": "node dist/main",
    "lint": "biome lint src/",
    "check": "biome check --write src/",
    "pretest": "prisma generate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.2.1",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@scalar/nestjs-api-reference": "^0.5.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dayjs": "^1.11.13",
    "express": "^5.0.0",
    "express-basic-auth": "^1.2.1",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^26.2.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.2.1",
    "jest": "^29.5.0",
    "prisma": "^7.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@@config$": "<rootDir>/common/config/index",
      "^@@decorators$": "<rootDir>/common/decorators/index",
      "^@@entities$": "<rootDir>/common/entities/index",
      "^@@exceptions$": "<rootDir>/common/exceptions/index",
      "^@@pipes$": "<rootDir>/common/pipes/index",
      "^@@prisma$": "<rootDir>/generated/prisma/client",
      "^@@cqrs$": "<rootDir>/common/cqrs/index",
      "^@@redis$": "<rootDir>/common/redis/index",
      "^@@db$": "<rootDir>/common/prisma/index",
      "^@@types$": "<rootDir>/common/types/index",
      "^src/(.*)$": "<rootDir>/$1"
    }
  }
}
